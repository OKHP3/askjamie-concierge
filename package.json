{
  "name": "askjamie-concierge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "tsx scripts/catalog.ts scan",
    "catalog": "tsx scripts/catalog.ts validate",
    "prepare:public": "tsx scripts/prepare-public.ts",
    "build": "pnpm prepare:public && pnpm --filter @askjamie/concierge build && pnpm --filter @askjamie/review-desk build && tsx scripts/stamp-build.ts",
    "validate": "pnpm typecheck && pnpm test && tsx scripts/check.ts catalog-integrity && tsx scripts/check.ts publishing-trigger-check",
    "dev": "pnpm --filter @askjamie/concierge dev",
    "review": "tsx apps/api/src/server.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yaml": "^2.9.1"
  }
}
